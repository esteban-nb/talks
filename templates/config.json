{
  "hash": true,
  "controls": false,
  "progress": true,
  "center": true,
  "help": true,
  "transition": "none",
  "transitionSpeed": "fast",
  "backgroundTransition": "fade",
  "slideNumber": "c/t",
  "pdfMaxPagesPerSlide": 1,
  "display": "block",
  "hideInactiveCursor": true,
  "hideCursorTime": 5000,
  "markdown": {
    "smartypants": true
  },
  "highlight": {
    "lineNumbers": true,
    "escapeHTML": true
  },
  "plugins": [
    "RevealMarkdown",
    "RevealHighlight",
    "RevealNotes",
    "RevealMath.MathJax3",
    "RevealZoom"
  ]
}
